rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to validate file data
    function isValidFileData(data) {
      return data.name is string &&
             data.title is string &&
             data.description is string &&
             data.size is number &&
             data.type is string &&
             data.uploadedAt is string &&
             data.downloadURL is string &&
             data.path is string;
    }

    // Helper function to validate doc data
    function isValidDocData(data) {
      return data.name is string &&
             data.description is string &&
             data.size is number &&
             data.downloadURL is string &&
             data.path is string &&
             data.status is string &&
             data.uploadedBy is string &&
             data.uploadedByEmail is string;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (request.auth.uid == userId && request.method == 'update');
    }

    // Files collection rules
    match /files/{fileId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidFileData(request.resource.data);
      allow delete: if isAdmin();
    }

    // Docs collection rules
    match /docs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDocData(request.resource.data);
      allow update: if isAdmin() && isValidDocData(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default rule - deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 